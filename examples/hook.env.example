# ~/.config/claude-beacon/env  (on each machine running Claude Code; hook/install.sh writes it)
BEACON_URL=http://your-beacon:8799
BEACON_TOKEN=replace-with-your-token
# BEACON_HOST=laptop        # machine name shown in the apps (default: short hostname)
# BEACON_LABEL=main         # fixed label for this machine's sessions (default: tmux session name)
# BEACON_TERMINAL=0         # don't set the terminal tab progress indicator
